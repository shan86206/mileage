            function renderCreditCardConverter(minMiles, calcData) {
                const progObj = CARD_PROGRAMS[appState.cardProgram] || CARD_PROGRAMS.cathay_tree;
                const points = Math.max(0, Number(appState.cardPoints) || 0);

                const noteEl = document.getElementById('card-program-note');
                if (noteEl) {
                    noteEl.textContent = '目前選定：' + progObj.label + '（輸入 ' + points.toLocaleString() + ' ' + progObj.unit + '）｜比對目標航線：' + calcData.originName + ' ➔ ' + calcData.destName + '（' + getCabinLabel(appState.cabin) + ' × ' + appState.pax + ' 人）';
                }

                const containerEl = document.getElementById('card-conversion-results');
                if (!containerEl) return;

                containerEl.innerHTML = AIRLINE_INFO.map(function (info) {
                    const rate = progObj.rates[info.key] || 0;
                    const convertedMiles = Math.floor(points * rate);
                    const airlineItem = calcData.items.find(function (i) { return i.key === info.key; });
                    const targetMiles = airlineItem && typeof airlineItem.miles === 'number' && airlineItem.miles > 0 ? airlineItem.miles : minMiles;

                    let statusHtml = '';
                    if (rate <= 0) {
                        statusHtml = '<span class="text-xs font-bold text-slate-400">此計畫不支援兌換</span>';
                    } else if (!targetMiles) {
                        statusHtml = '<span class="text-xs font-semibold text-slate-500">無對應航線門檻</span>';
                    } else if (convertedMiles >= targetMiles) {
                        const surplus = convertedMiles - targetMiles;
                        statusHtml = '<span class="text-xs font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg inline-block">已達標（多 ' + surplus.toLocaleString() + ' 哩）</span>';
                    } else {
                        const gap = targetMiles - convertedMiles;
                        statusHtml = '<span class="text-xs font-extrabold text-amber-800 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-lg inline-block">還差 ' + gap.toLocaleString() + ' 哩</span>';
                    }

                    return (
                        '<div class="bg-slate-50 rounded-xl p-4 border border-slate-200 flex flex-col justify-between gap-3">' +
                            '<div>' +
                                '<div class="text-xs font-extrabold text-navy-900">' + info.code + ' · ' + info.name + '</div>' +
                                '<div class="text-2xl font-extrabold text-navy-900 mt-2">' + convertedMiles.toLocaleString() + '<span class="text-xs font-bold text-slate-500 ml-1">哩</span></div>' +
                                '<div class="text-[11px] text-slate-500 mt-1">目標門檻：' + (targetMiles ? targetMiles.toLocaleString() + ' 哩' : '—') + '</div>' +
                            '</div>' +
                            '<div>' + statusHtml + '</div>' +
                        '</div>'
                    );
                }).join('');
            }

            function renderAirlineRules() {
                const containerEl = document.getElementById('airline-rules-list');
                if (!containerEl) return;

                containerEl.innerHTML = AIRLINE_INFO.map(function (info) {
                    return (
                        '<article class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-3">' +
                            '<div class="flex items-center justify-between gap-2 border-b border-slate-200 pb-2.5">' +
                                '<div>' +
                                    '<h3 class="text-base font-extrabold text-navy-900">' + info.name + '（' + info.code + '）</h3>' +
                                    '<p class="text-xs text-slate-500">' + info.program + '</p>' +
                                '</div>' +
                                '<span class="text-xs font-bold px-2.5 py-1 rounded-full bg-navy-900 text-gold-400">' + info.releaseWindow + '</span>' +
                            '</div>' +
                            '<dl class="space-y-2 text-xs sm:text-sm">' +
                                '<div><dt class="font-bold text-navy-900 inline">燃油附加費水準：</dt><dd class="text-slate-700 inline">' + info.fuelLevel + '</dd></div>' +
                                '<div><dt class="font-bold text-navy-900 inline">中停／開口規定：</dt><dd class="text-slate-700 inline">' + info.stopoverRule + '</dd></div>' +
                                '<div class="bg-white rounded-xl p-3 border border-slate-200 text-xs text-slate-700"><strong class="text-navy-900">查票與開票建議：</strong>' + info.tip + '</div>' +
                            '</dl>' +
                        '</article>'
                    );
                }).join('');
            }

            // ==================== 事件綁定 ====================
            function switchTab(tabKey) {
                appState.activeTab = tabKey;
                const map = {
                    calc: 'section-calc',
                    card: 'section-card',
                    rules: 'section-rules'
                };
                Object.keys(map).forEach(function (k) {
                    const sec = document.getElementById(map[k]);
                    if (sec) {
                        if (k === tabKey) sec.classList.remove('hidden');
                        else sec.classList.add('hidden');
                    }
                });

                document.querySelectorAll('.nav-tab').forEach(function (btn) {
                    const isActive = btn.getAttribute('data-tab') === tabKey;
                    if (isActive) {
                        btn.className = 'nav-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs sm:text-sm font-bold bg-gold-500 text-navy-950 transition cursor-pointer';
                    } else {
                        btn.className = 'nav-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-200 hover:text-white hover:bg-navy-800 transition cursor-pointer';
                    }
                });

                renderAll();
                setStatusMessage('已切換至「' + (tabKey === 'calc' ? '哩程試算與查空位' : (tabKey === 'card' ? '信用卡點數換算' : '開票與放票規則')) + '」。', '分頁已切換');
            }

            function syncButtonGroupActive() {
                document.querySelectorAll('.trip-btn').forEach(function (btn) {
                    const active = btn.getAttribute('data-trip') === appState.tripType;
                    btn.className = active
                        ? 'trip-btn py-2 rounded-lg text-xs font-bold bg-navy-900 text-gold-400 shadow-sm transition cursor-pointer'
                        : 'trip-btn py-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer';
                });

                document.querySelectorAll('.cabin-btn').forEach(function (btn) {
                    const active = btn.getAttribute('data-cabin') === appState.cabin;
                    btn.className = active
                        ? 'cabin-btn py-2 px-2 rounded-lg text-xs font-bold bg-navy-900 text-gold-400 shadow-sm transition cursor-pointer'
                        : 'cabin-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer';
                });

                document.querySelectorAll('.season-btn').forEach(function (btn) {
                    const active = btn.getAttribute('data-season') === appState.season;
                    btn.className = active
                        ? 'season-btn py-2 px-2 rounded-lg text-xs font-bold bg-navy-900 text-gold-400 shadow-sm transition cursor-pointer'
                        : 'season-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer';
                });

                const retWrapper = document.getElementById('return-date-wrapper');
                if (retWrapper) {
                    if (appState.tripType === 'oneway') retWrapper.classList.add('opacity-50');
                    else retWrapper.classList.remove('opacity-50');
                }
            }

            function bindDynamicActionButtons() {
                document.querySelectorAll('.external-portal-link').forEach(function (link) {
                    link.onclick = function () {
                        const name = link.getAttribute('data-portal-name') || '外部查詢頁';
                        const href = link.getAttribute('href') || '';
                        setStatusMessage('已嘗試開啟 ' + name + '（' + href + '）。若未開出新分頁，請按「複製連結」貼至瀏覽器開啟。', '外部連結');
                    };
                });

                document.querySelectorAll('.copy-url-btn').forEach(function (btn) {
                    btn.onclick = function () {
                        const url = btn.getAttribute('data-copy-url') || '';
                        const name = btn.getAttribute('data-portal-name') || '連結';
                        copyTextWithFallback(url, '已複製「' + name + '」網址：' + url);
                    };
                });
            }

            function initApp() {
                // 分頁按鈕
                document.querySelectorAll('.nav-tab').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        const tab = btn.getAttribute('data-tab');
                        if (tab) switchTab(tab);
                    });
                });

                // 下拉選單與日期
                const originEl = document.getElementById('select-origin');
                const destEl = document.getElementById('select-dest');
                const paxEl = document.getElementById('select-pax');
                const depDateEl = document.getElementById('input-depart-date');
                const retDateEl = document.getElementById('input-return-date');

                if (originEl) {
                    originEl.addEventListener('change', function () {
                        appState.origin = originEl.value;
                        renderAll();
                        setStatusMessage('已更新出發地為 ' + originEl.options[originEl.selectedIndex].text + '。', '條件更新');
                    });
                }

                if (destEl) {
                    destEl.addEventListener('change', function () {
                        appState.dest = destEl.value;
                        renderAll();
                        setStatusMessage('已更新目的地為 ' + destEl.options[destEl.selectedIndex].text + '。', '條件更新');
                    });
                }

                if (paxEl) {
                    paxEl.addEventListener('change', function () {
                        appState.pax = Math.min(4, Math.max(1, parseInt(paxEl.value, 10) || 1));
                        renderAll();
                        setStatusMessage('已更新旅客人數為 ' + appState.pax + ' 位。', '條件更新');
                    });
                }

                if (depDateEl) {
                    depDateEl.addEventListener('change', function () {
                        appState.departDate = depDateEl.value;
                        renderAll();
                        setStatusMessage('已更新去程日期為 ' + (appState.departDate || '未指定') + '。', '日期更新');
                    });
                }

                if (retDateEl) {
                    retDateEl.addEventListener('change', function () {
                        appState.returnDate = retDateEl.value;
                        renderAll();
                        setStatusMessage('已更新回程日期為 ' + (appState.returnDate || '未指定') + '。', '日期更新');
                    });
                }

                // 行程類型按鈕
                document.querySelectorAll('.trip-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        appState.tripType = btn.getAttribute('data-trip') || 'roundtrip';
                        syncButtonGroupActive();
                        renderAll();
                        setStatusMessage('已切換為' + (appState.tripType === 'roundtrip' ? '來回 (RT)' : '單程 (OW)') + '。', '條件更新');
                    });
                });

                // 艙等按鈕
                document.querySelectorAll('.cabin-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        appState.cabin = btn.getAttribute('data-cabin') || 'business';
                        syncButtonGroupActive();
                        renderAll();
                        setStatusMessage('已切換艙等為「' + getCabinLabel(appState.cabin) + '」。', '條件更新');
                    });
                });

                // 季節按鈕
                document.querySelectorAll('.season-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        appState.season = btn.getAttribute('data-season') || 'regular';
                        syncButtonGroupActive();
                        renderAll();
                        setStatusMessage('已切換季節為「' + getSeasonLabel(appState.season) + '」。', '條件更新');
                    });
                });

                // 重設預設條件
                const resetBtn = document.getElementById('btn-reset-defaults');
                if (resetBtn) {
                    resetBtn.addEventListener('click', function () {
                        appState.origin = 'TPE';
                        appState.dest = 'TYO';
                        appState.tripType = 'roundtrip';
                        appState.cabin = 'business';
                        appState.pax = 1;
                        appState.season = 'regular';
                        appState.departDate = '2027-03-15';
                        appState.returnDate = '2027-03-22';

                        if (originEl) originEl.value = 'TPE';
                        if (destEl) destEl.value = 'TYO';
                        if (paxEl) paxEl.value = '1';
                        if (depDateEl) depDateEl.value = '2027-03-15';
                        if (retDateEl) retDateEl.value = '2027-03-22';

                        syncButtonGroupActive();
                        renderAll();
                        setStatusMessage('已重設為預設查詢條件（TPE ⇄ TYO、商務艙、2027-03-15 ~ 2027-03-22）。', '已重設');
                    });
                }

                // 一鍵複製查票參數
                const copyParamsBtn = document.getElementById('btn-copy-params');
                if (copyParamsBtn) {
                    copyParamsBtn.addEventListener('click', function () {
                        const paramEl = document.getElementById('search-param-summary');
                        const text = paramEl ? paramEl.textContent : '';
                        copyTextWithFallback(text, '已複製查票參數：' + text);
                    });
                }

                // 信用卡點數換算器事件
                const cardProgEl = document.getElementById('select-card-program');
                const cardPtsEl = document.getElementById('input-card-points');
                if (cardProgEl) {
                    cardProgEl.addEventListener('change', function () {
                        appState.cardProgram = cardProgEl.value;
                        renderAll();
                        setStatusMessage('已切換信用卡積分計畫。', '換算更新');
                    });
                }
                if (cardPtsEl) {
                    cardPtsEl.addEventListener('input', function () {
                        appState.cardPoints = Math.max(0, Number(cardPtsEl.value) || 0);
                        renderAll();
                    });
                }

                syncButtonGroupActive();
                renderAll();
            }

            document.addEventListener('DOMContentLoaded', function () {
                try {
                    initApp();
                } catch (err) {
                    const banner = document.getElementById('fatal-error-banner');
                    const detail = document.getElementById('fatal-error-detail');
                    if (banner) banner.classList.remove('hidden');
                    if (detail) detail.textContent = err && err.message ? err.message : String(err);
                }
            });
        })();
    </script>
</body>
</html>
