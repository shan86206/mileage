                if (headingEl) headingEl.textContent = calcData.originName + ' ' + arrow + ' ' + calcData.destName;
                if (distPillEl) distPillEl.textContent = '單程約 ' + calcData.distance.toLocaleString() + ' 哩';
                if (cabinPillEl) {
                    cabinPillEl.textContent = getCabinLabel(appState.cabin) + ' · ' + (appState.tripType === 'roundtrip' ? '來回' : '單程') + ' · ' + appState.pax + ' 人';
