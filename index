                                '<div>' +
                                    '<div class="flex items-center justify-between gap-2 mb-2">' +
                                        '<span class="text-xs font-extrabold px-2.5 py-0.5 rounded-full bg-navy-900 text-gold-400">' + item.code + '</span>' +
                                        (isLowest
                                            ? '<span class="text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-gold-500 text-navy-950">最低哩程</span>'
                                            : '<span class="text-[11px] font-semibold text-slate-400">' + item.program + '</span>') +
                                    '</div>' +
                                    '<h3 class="text-base font-extrabold text-navy-900">' + item.name + '</h3>' +
                                    '<div class="mt-3 p-3 rounded-xl bg-slate-50 border border-slate-200/70">' +
                                        milesHtml +
                                        '<p class="text-[11px] text-slate-600 mt-1.5 leading-relaxed">' + item.detail + '</p>' +
                                        '<p class="text-[11px] text-slate-500 mt-1">稅金/燃油參考：' + item.tax + '</p>' +
                                    '</div>' +
                                '</div>' +
                                '<div class="flex items-center gap-2">' +
                                    '<a href="' + item.portalUrl + '" target="_blank" rel="noopener noreferrer" data-portal-name="' + item.name + '" class="external-portal-link flex-1 text-center py-2.5 px-3 rounded-xl bg-navy-900 hover:bg-navy-800 text-gold-400 text-xs font-extrabold transition">' +
                                        '官網查票' +
                                    '</a>' +
                                    '<button type="button" data-copy-url="' + item.portalUrl + '" data-portal-name="' + item.name + '" class="copy-url-btn py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-navy-900 text-xs font-bold border border-slate-300 transition cursor-pointer">' +
                                        '複製連結' +
                                    '</button>' +
                                '</div>' +
                            '</article>'
                        );
                    }).join('');
                }

                // 渲染查空位中控台資訊
                renderSearchConsole(calcData);

                // 渲染信用卡換算分頁
                renderCreditCardConverter(minMiles, calcData);

                // 渲染開票規則分頁
                renderAirlineRules();

                // 重新綁定動態產生的連結與複製按鈕事件
                bindDynamicActionButtons();
            }

