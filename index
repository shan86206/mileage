                if (appState.origin === 'TYO' && appState.dest === 'TYO') {
                    return {
                        distance: 0,
                        taxRef: '依實際航段稅費為準',
                        items: AIRLINE_INFO.map(function (info) {
                            return {
                                key: info.key,
                                code: info.code,
                                name: info.name,
                                program: info.program,
                                portalUrl: info.portalUrl,
                                miles: 0,
                                detail: '出發地與目的地同為東京，請改選其他航點',
                                tax: '—'
                            };
                        })
                    };
                }

                // 估算距離
                let distance = destObj.dist;
                if (appState.origin === 'HKG') {
                    distance = Math.max(480, Math.round(destObj.dist * 1.12));
                } else if (appState.origin === 'TYO') {
                    distance = Math.max(850, Math.round(destObj.dist * 0.88));
                }

                // 1. 華航：三級動態區間
                const ciBase = CI_ONEWAY_RATES[destObj.ciZone] && CI_ONEWAY_RATES[destObj.ciZone][season]
                    ? CI_ONEWAY_RATES[destObj.ciZone][season][cabin]
                    : null;
                const ciMiles = ciBase !== null ? ciBase * legMultiplier * pax : null;

                // 2. 長榮：標準/特惠邏輯（以標準區間為基準並提示特惠浮動）
                const brBase = BR_ONEWAY_RATES[destObj.brZone] ? BR_ONEWAY_RATES[destObj.brZone][cabin] : null;
                const brMiles = brBase !== null ? brBase * legMultiplier * pax : null;

                // 3. 國泰：直飛與香港轉機累加
                const cxDirect = getCathaySingleMiles(distance, cabin);
                let cxMiles = null;
                let cxDetail = '距離區間 Band ' + cxDirect.band + '（直飛估算）';
                if (cxDirect.miles !== null) {
                    if (appState.origin === 'TPE' && appState.dest !== 'HKG') {
                        const leg1 = getCathaySingleMiles(500, cabin).miles;
                        const leg2 = getCathaySingleMiles(Math.max(600, Math.abs(distance - 450)), cabin).miles;
                        const transitTotal = (leg1 + leg2) * legMultiplier * pax;
                        cxMiles = cxDirect.miles * legMultiplier * pax;
                        cxDetail = '直飛 ' + cxMiles.toLocaleString() + ' 哩｜經港轉機約 ' + transitTotal.toLocaleString() + ' 哩';
                    } else {
                        cxMiles = cxDirect.miles * legMultiplier * pax;
                    }
                }

                // 4. 星宇：區域與頭等艙
                const jxBase = JX_ONEWAY_RATES[destObj.jxZone] ? JX_ONEWAY_RATES[destObj.jxZone][cabin] : null;
                const jxMiles = jxBase !== null ? jxBase * legMultiplier * pax : null;

                // 5. ANA：單程與淡平旺季
                const anaRtBase = ANA_ROUNDTRIP_RATES[destObj.anaZone] && ANA_ROUNDTRIP_RATES[destObj.anaZone][season]
                    ? ANA_ROUNDTRIP_RATES[destObj.anaZone][season][cabin]
                    : null;
                const anaMiles = anaRtBase !== null
                    ? (isRoundtrip ? anaRtBase : Math.round(anaRtBase / 2)) * pax
                    : null;

                const rawMap = {
                    ci: {
                        miles: ciMiles,
                        detail: ciMiles !== null ? '2026 三級動態（' + getSeasonLabel(season) + '）' : '此艙等未提供'
                    },
                    br: {
                        miles: brMiles,
                        detail: brMiles !== null ? '標準區間制（特惠席次依釋出為準）' : '此艙等未提供'
                    },
                    cx: {
                        miles: cxMiles,
                        detail: cxMiles !== null ? cxDetail : '此艙等未提供'
                    },
                    jx: {
                        miles: jxMiles,
                        detail: jxMiles !== null ? (cabin === 'first' ? '頭等艙區域制' : '區域兌換表') : '此航線此艙等未提供'
                    },
                    nh: {
                        miles: anaMiles,
                        detail: anaMiles !== null ? (isRoundtrip ? '來回' + getSeasonLabel(season) + '制' : '單程（來回一半估算）') : '此艙等未提供'
                    }
                };

                const items = AIRLINE_INFO.map(function (info) {
                    const entry = rawMap[info.key];
                    return {
                        key: info.key,
                        code: info.code,
                        name: info.name,
                        program: info.program,
                        portalUrl: info.portalUrl,
                        miles: entry.miles,
                        detail: entry.detail,
                        tax: destObj.taxRef
                    };
                });

                return {
                    originName: originObj.name,
                    destName: destObj.name,
                    distance: distance,
                    taxRef: destObj.taxRef,
                    items: items
                };
            }

            // ==================== 渲染函式 ====================
            function renderAll() {
                const calcData = calculateMilesForAll();

                // 更新航線摘要
                const arrow = appState.tripType === 'roundtrip' ? '⇄' : '➔';
                const headingEl = document.getElementById('summary-route-heading');
                const distPillEl = document.getElementById('summary-distance-pill');
                const cabinPillEl = document.getElementById('summary-cabin-pill');
