<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2026 五航司里程票兌換查詢與查票中控台</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans TC"', 'Inter', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            950: '#070E1A',
                            900: '#0B1628',
                            800: '#12233E',
                            700: '#1D355B',
                        },
                        gold: {
                            400: '#E5C76B',
                            500: '#D4AF37',
                            600: '#B59124',
                        },
                        ivory: '#F8F9FA',
                    },
                },
            },
        };
    </script>
    <style>
        body {
            background-color: #F8F9FA;
            color: #0B1628;
            font-family: 'Noto Sans TC', 'Inter', sans-serif;
        }
        .gold-accent-bar {
            background: linear-gradient(90deg, #D4AF37 0%, #E5C76B 50%, #B59124 100%);
        }
        .card-elevated {
            box-shadow: 0 10px 28px -6px rgba(11, 22, 40, 0.08), 0 4px 12px -4px rgba(11, 22, 40, 0.04);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-ivory text-navy-900 selection:bg-gold-400 selection:text-navy-950">

    <!-- 頂部導覽列 -->
    <header class="bg-navy-900 text-white border-b border-gold-500/30 sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div class="flex items-start sm:items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-navy-800 border border-gold-500/60 flex items-center justify-center text-gold-400 font-extrabold text-lg shrink-0">
                    5X
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white">
                            2026 五航司里程票兌換查詢與查票中控台
                        </h1>
                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-gold-500/20 text-gold-400 border border-gold-500/40">
                            CI · BR · CX · JX · NH
                        </span>
                    </div>
                    <p class="text-xs text-slate-300 mt-0.5">
                        整合航線哩程試算、跨平台查空位中控台、信用卡積分換算與五航司開票規則
                    </p>
                </div>
            </div>

            <!-- 主分頁切換器 -->
            <nav aria-label="主要功能分頁" class="flex flex-wrap sm:flex-nowrap gap-2 bg-navy-950/80 p-1.5 rounded-xl border border-white/10">
                <button type="button" id="nav-tab-calc" data-tab="calc" class="nav-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs sm:text-sm font-bold bg-gold-500 text-navy-950 transition cursor-pointer">
                    1. 哩程試算與查空位
                </button>
                <button type="button" id="nav-tab-card" data-tab="card" class="nav-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-200 hover:text-white hover:bg-navy-800 transition cursor-pointer">
                    2. 信用卡點數換算
                </button>
                <button type="button" id="nav-tab-rules" data-tab="rules" class="nav-tab flex-1 sm:flex-none px-4 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-200 hover:text-white hover:bg-navy-800 transition cursor-pointer">
                    3. 開票與放票規則
                </button>
            </nav>
        </div>
        <div class="h-1 w-full gold-accent-bar"></div>
    </header>

    <!-- 錯誤邊界提示區（發生任何例外時顯示，避免白屏） -->
    <div id="fatal-error-banner" class="hidden max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4">
        <div class="bg-red-50 border-2 border-red-400 text-red-900 rounded-2xl p-4 flex items-start gap-3">
            <span class="font-extrabold text-sm px-2 py-0.5 rounded bg-red-600 text-white shrink-0">系統提示</span>
            <div class="text-xs sm:text-sm space-y-1">
                <p class="font-bold">應用程式初始化或渲染時捕捉到異常，已啟動安全保護：</p>
                <p id="fatal-error-detail" class="font-mono text-xs text-red-800 break-all"></p>
            </div>
        </div>
    </div>

    <!-- 即時狀態回饋列 -->
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4">
        <div id="status-feedback-bar" class="bg-navy-800 text-white rounded-2xl px-4 py-3 border border-gold-500/30 flex flex-col md:flex-row md:items-center md:justify-between gap-2 shadow-sm">
            <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-2.5 h-2.5 rounded-full bg-gold-400 shrink-0"></span>
                <span id="status-feedback-text" class="text-xs sm:text-sm font-medium text-slate-100 truncate">
                    就緒：請調整航線、日期或艙等條件，系統將即時同步哩程試算與查票參數。
                </span>
            </div>
            <span id="status-feedback-badge" class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-navy-950 text-gold-400 border border-gold-500/30 shrink-0 self-start md:self-auto">
                即時同步中
            </span>
        </div>
    </div>

    <!-- 主內容區 -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">

        <!-- ==================== 分頁 1：哩程試算與跨平台查空位中控台 ==================== -->
        <section id="section-calc" class="space-y-8">

            <!-- 查詢條件面板 -->
            <div class="bg-white rounded-2xl border border-slate-200 card-elevated p-5 sm:p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-4 mb-5 border-b border-slate-100">
                    <div>
                        <h2 class="text-base sm:text-lg font-extrabold text-navy-900">航線與查票條件設定</h2>
                        <p class="text-xs text-slate-500 mt-0.5">支援單程/來回、四種艙等、1~4 位旅客、ANA 淡平旺季與去回程日期</p>
                    </div>
                    <button type="button" id="btn-reset-defaults" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-navy-900 border border-slate-300 transition cursor-pointer self-start sm:self-auto">
                        重設預設條件
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- 出發地 -->
                    <div>
                        <label for="select-origin" class="block text-xs font-bold text-navy-900 mb-1.5">出發地 (Origin)</label>
                        <select id="select-origin" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-navy-900 focus:outline-none focus:ring-2 focus:ring-gold-500">
                            <option value="TPE">台灣 (TPE)</option>
                            <option value="HKG">香港 (HKG)</option>
                            <option value="TYO">東京 (NRT/HND)</option>
                        </select>
                    </div>

                    <!-- 目的地 -->
                    <div>
                        <label for="select-dest" class="block text-xs font-bold text-navy-900 mb-1.5">目的地 (Destination)</label>
                        <select id="select-dest" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-navy-900 focus:outline-none focus:ring-2 focus:ring-gold-500">
                            <option value="TYO">東京 (NRT/HND)</option>
                            <option value="OSA">大阪 (KIX)</option>
                            <option value="FUK">福岡 (FUK)</option>
                            <option value="CTS">札幌 (CTS)</option>
                            <option value="OKA">沖繩 (OKA)</option>
                            <option value="SEL">首爾 (ICN)</option>
                            <option value="BKK">曼谷 (BKK)</option>
                            <option value="SIN">新加坡 (SIN)</option>
                            <option value="SYD">雪梨 (SYD)</option>
                            <option value="YVR">溫哥華 (YVR)</option>
                            <option value="LAX">洛杉磯 (LAX)</option>
                            <option value="SFO">舊金山 (SFO)</option>
                            <option value="SEA">西雅圖 (SEA)</option>
                            <option value="JFK">紐約 (JFK)</option>
                            <option value="LHR">倫敦 (LHR)</option>
                            <option value="CDG">巴黎 (CDG)</option>
                            <option value="FRA">法蘭克福 (FRA)</option>
                        </select>
                    </div>

                    <!-- 行程類型 -->
                    <div>
                        <label class="block text-xs font-bold text-navy-900 mb-1.5">行程類型</label>
                        <div class="grid grid-cols-2 gap-2 bg-slate-100 p-1 rounded-xl border border-slate-200">
                            <button type="button" id="btn-trip-oneway" data-trip="oneway" class="trip-btn py-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer">
                                單程 (OW)
                            </button>
                            <button type="button" id="btn-trip-roundtrip" data-trip="roundtrip" class="trip-btn py-2 rounded-lg text-xs font-bold bg-navy-900 text-gold-400 shadow-sm transition cursor-pointer">
                                來回 (RT)
                            </button>
                        </div>
                    </div>

                    <!-- 旅客人數 -->
                    <div>
                        <label for="select-pax" class="block text-xs font-bold text-navy-900 mb-1.5">旅客人數 (1~4 人)</label>
                        <select id="select-pax" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-navy-900 focus:outline-none focus:ring-2 focus:ring-gold-500">
                            <option value="1">1 位旅客</option>
                            <option value="2">2 位旅客</option>
                            <option value="3">3 位旅客</option>
                            <option value="4">4 位旅客</option>
                        </select>
                    </div>

                    <!-- 艙等選擇 -->
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-navy-900 mb-1.5">艙等 (Cabin)</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 bg-slate-100 p-1 rounded-xl border border-slate-200">
                            <button type="button" data-cabin="economy" class="cabin-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer">
                                經濟艙
                            </button>
                            <button type="button" data-cabin="premium" class="cabin-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer">
                                豪華經濟艙
                            </button>
                            <button type="button" data-cabin="business" class="cabin-btn py-2 px-2 rounded-lg text-xs font-bold bg-navy-900 text-gold-400 shadow-sm transition cursor-pointer">
                                商務艙
                            </button>
                            <button type="button" data-cabin="first" class="cabin-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer">
                                頭等艙
                            </button>
                        </div>
                    </div>

                    <!-- ANA 季節 -->
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-navy-900 mb-1.5">季節區間（影響 ANA 淡平旺季與華航三級動態）</label>
                        <div class="grid grid-cols-3 gap-2 bg-slate-100 p-1 rounded-xl border border-slate-200">
                            <button type="button" data-season="low" class="season-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer">
                                淡季 (Low)
                            </button>
                            <button type="button" data-season="regular" class="season-btn py-2 px-2 rounded-lg text-xs font-bold bg-navy-900 text-gold-400 shadow-sm transition cursor-pointer">
                                平季 (Regular)
                            </button>
                            <button type="button" data-season="peak" class="season-btn py-2 px-2 rounded-lg text-xs font-bold text-slate-700 hover:text-navy-900 transition cursor-pointer">
                                旺季 (Peak)
                            </button>
                        </div>
                    </div>

                    <!-- 去程日期 -->
                    <div>
                        <label for="input-depart-date" class="block text-xs font-bold text-navy-900 mb-1.5">去程日期</label>
                        <input type="date" id="input-depart-date" value="2027-03-15" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-navy-900 focus:outline-none focus:ring-2 focus:ring-gold-500">
                    </div>

                    <!-- 回程日期 -->
                    <div id="return-date-wrapper">
                        <label for="input-return-date" class="block text-xs font-bold text-navy-900 mb-1.5">回程日期</label>
                        <input type="date" id="input-return-date" value="2027-03-22" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-navy-900 focus:outline-none focus:ring-2 focus:ring-gold-500">
                    </div>
                </div>

                <!-- 航線摘要橫幅 -->
                <div class="mt-5 pt-4 border-t border-slate-100 flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-navy-900/5 rounded-xl p-3.5">
                    <div class="flex flex-wrap items-center gap-2.5">
                        <span id="summary-route-heading" class="text-sm sm:text-base font-extrabold text-navy-900">
                            台灣 (TPE) ⇄ 東京 (NRT/HND)
                        </span>
                        <span id="summary-distance-pill" class="text-xs font-bold px-2.5 py-1 rounded-full bg-navy-900 text-gold-400">
                            單程約 1,355 哩
                        </span>
                        <span id="summary-cabin-pill" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white text-navy-800 border border-slate-200">
                            商務艙 · 來回 · 1 人
                        </span>
                    </div>
                    <div id="summary-best-callout" class="text-xs sm:text-sm font-extrabold text-navy-900">
                        最低門檻計算中...
                    </div>
                </div>
            </div>

            <!-- 五航司並排比價卡片區 -->
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-base sm:text-lg font-extrabold text-navy-900">五航司所需哩程並排比價</h2>
                    <span class="text-xs text-slate-500">已自動標註目前條件下最低哩程方案</span>
                </div>
                <div id="airlines-comparison-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4">
                    <!-- 由 JavaScript 完整渲染 -->
                </div>
            </div>

            <!-- ==================== 二、跨平台查空位中控台 ==================== -->
            <div class="bg-navy-900 text-white rounded-2xl border border-gold-500/40 card-elevated p-5 sm:p-6 space-y-6">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 border-b border-white/10 pb-4">
                    <div>
                        <div class="inline-flex items-center gap-2 text-xs font-bold text-gold-400 mb-1">
                            <span>跨平台查空位中控台</span>
                            <span>·</span>
                            <span>減少多頁跳轉與重複輸入</span>
                        </div>
                        <h2 class="text-lg sm:text-xl font-extrabold text-white">
                            一站式查票參數、聯盟子艙等與空位查詢入口
                        </h2>
                        <p class="text-xs text-slate-300 mt-1">
                            各航司即時會員座位需於官網登入查詢；本中控台整理查票參數、聯盟子艙等、聚合搜尋引擎與五航司官網直達入口，點擊皆會提供狀態提示與網址複製備援。
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-2.5 shrink-0">
                        <button type="button" id="btn-copy-params" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-extrabold bg-gold-500 hover:bg-gold-400 text-navy-950 transition shadow cursor-pointer">
                            一鍵複製查票參數
                        </button>
                    </div>
                </div>

                <!-- 查票參數摘要與子艙等參考 -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
                    <div class="lg:col-span-2 bg-navy-800/90 rounded-xl p-4 border border-white/10 space-y-2">
                        <div class="text-xs font-bold text-gold-400">目前查票參數摘要</div>
                        <div id="search-param-summary" class="text-xs sm:text-sm font-mono text-white bg-navy-950/70 rounded-lg p-3 border border-white/10 break-all">
                            載入中...
                        </div>
                        <p class="text-[11px] text-slate-300">
                            提示：若您在預覽視窗（iframe）中點擊外部連結未自動彈出，可直接使用各卡片旁的「複製網址」按鈕貼至瀏覽器新分頁開啟。
                        </p>
                    </div>

                    <div class="bg-navy-800/90 rounded-xl p-4 border border-white/10 space-y-2">
                        <div class="text-xs font-bold text-gold-400">目前艙等聯盟子艙等參考</div>
                        <div id="fare-class-reference" class="text-xs text-slate-200 space-y-1.5 leading-relaxed">
                            載入中...
                        </div>
                    </div>
                </div>

                <!-- 跨聯盟聚合引擎入口 -->
                <div class="space-y-3">
                    <h3 class="text-sm font-extrabold text-gold-400">跨聯盟獎勵機位聚合引擎</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Seats.aero -->
                        <div class="bg-navy-800 rounded-xl p-4 border border-white/10 flex flex-col justify-between gap-3">
                            <div>
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-sm font-extrabold text-white">Seats.aero</span>
                                    <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-gold-500/20 text-gold-400">跨月掃描</span>
                                </div>
                                <p class="text-xs text-slate-300 mt-1.5">
                                    適合快速瀏覽星空聯盟（長榮、ANA）與寰宇一家（國泰、日航）跨日期獎勵機位趨勢。
                                </p>
                            </div>
                            <div class="flex items-center gap-2 pt-1">
                                <a id="link-seats-aero" href="https://seats.aero/" target="_blank" rel="noopener noreferrer" data-portal-name="Seats.aero" class="external-portal-link flex-1 text-center py-2 px-3 rounded-lg bg-gold-500 hover:bg-gold-400 text-navy-950 text-xs font-extrabold transition">
                                    開啟 Seats.aero
                                </a>
                                <button type="button" data-copy-url="https://seats.aero/" data-portal-name="Seats.aero" class="copy-url-btn py-2 px-3 rounded-lg bg-navy-950 hover:bg-navy-700 text-slate-200 text-xs font-bold border border-white/15 transition cursor-pointer">
                                    複製網址
                                </button>
                            </div>
                        </div>

                        <!-- Point.me -->
                        <div class="bg-navy-800 rounded-xl p-4 border border-white/10 flex flex-col justify-between gap-3">
                            <div>
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-sm font-extrabold text-white">Point.me</span>
                                    <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-gold-500/20 text-gold-400">航線比對</span>
                                </div>
                                <p class="text-xs text-slate-300 mt-1.5">
                                    適合比對不同哩程計畫兌換同一航線的哩程需求與轉機組合方式。
                                </p>
                            </div>
                            <div class="flex items-center gap-2 pt-1">
                                <a id="link-point-me" href="https://www.point.me/" target="_blank" rel="noopener noreferrer" data-portal-name="Point.me" class="external-portal-link flex-1 text-center py-2 px-3 rounded-lg bg-gold-500 hover:bg-gold-400 text-navy-950 text-xs font-extrabold transition">
                                    開啟 Point.me
                                </a>
                                <button type="button" data-copy-url="https://www.point.me/" data-portal-name="Point.me" class="copy-url-btn py-2 px-3 rounded-lg bg-navy-950 hover:bg-navy-700 text-slate-200 text-xs font-bold border border-white/15 transition cursor-pointer">
                                    複製網址
                                </button>
                            </div>
                        </div>

                        <!-- Roame.travel -->
                        <div class="bg-navy-800 rounded-xl p-4 border border-white/10 flex flex-col justify-between gap-3">
                            <div>
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-sm font-extrabold text-white">Roame.travel</span>
                                    <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-gold-500/20 text-gold-400">快速檢索</span>
                                </div>
                                <p class="text-xs text-slate-300 mt-1.5">
                                    適合快速檢索熱門航點與多日區間的獎勵機位可用性與航司選項。
                                </p>
                            </div>
                            <div class="flex items-center gap-2 pt-1">
                                <a id="link-roame" href="https://roame.travel/" target="_blank" rel="noopener noreferrer" data-portal-name="Roame.travel" class="external-portal-link flex-1 text-center py-2 px-3 rounded-lg bg-gold-500 hover:bg-gold-400 text-navy-950 text-xs font-extrabold transition">
